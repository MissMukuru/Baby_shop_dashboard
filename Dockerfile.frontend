# Dockerfile.frontend — builds the Streamlit dashboard only.
# Build:  docker build -f Dockerfile.frontend -t nila-frontend .
# Run:    docker run -p 8501:8501 nila-frontend

FROM python:3.11-slim

WORKDIR /code

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY Nila_baby_shop/ ./Nila_baby_shop/
COPY data/ ./data/

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')" || exit 1

CMD ["streamlit", "run", "Nila_baby_shop/dashboard_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
